# ============================================
# FMS Backend — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya
# JANGAN PERNAH commit file .env ke git!
# ============================================

# --- Environment ---
# development | production | test | staging
NODE_ENV=development

# --- Server ---
# Port HTTP API
PORT=3346

# Port TCP Teltonika (server menerima data GPS tracker)
TELTONIKA_TCP_PORT=5550

# --- Database (PostgreSQL) ---
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/fms_db?schema=public

# --- JWT ---
# WAJIB diganti! Minimal 16 karakter, gunakan string acak yang panjang.
# Generate: openssl rand -base64 64
JWT_SECRET=GantiDenganSecretYangSangatPanjangDanAcak1234567890
# Durasi token (contoh: 1h, 1d, 7d, 30d)
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Daftar origin frontend yang diizinkan, dipisah koma.
# Contoh: https://fms.example.com,https://admin.fms.example.com
# Kosongkan = blok semua origin (recommended untuk production tanpa frontend resmi)
CORS_ORIGIN=http://localhost:3000
