# ============================================
# FMS Backend — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya
# JANGAN PERNAH commit file .env ke git!
# ============================================

# --- Environment ---
# development | production | test | staging
NODE_ENV=development

# --- Server ---
# Port HTTP API
PORT=3346

# Port TCP Teltonika (server menerima data GPS tracker)
TELTONIKA_TCP_PORT=5550

# --- Database (PostgreSQL) ---
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/fms_db?schema=public

# --- JWT ---
# WAJIB diganti! Minimal 16 karakter, gunakan string acak yang panjang.
# Generate: openssl rand -base64 64
JWT_SECRET=GantiDenganSecretYangSangatPanjangDanAcak1234567890
# Durasi token (contoh: 1h, 1d, 7d, 30d)
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Daftar origin frontend yang diizinkan, dipisah koma.
# Contoh: https://fms.example.com,https://admin.fms.example.com
# Kosongkan = blok semua origin (recommended untuk production tanpa frontend resmi)
CORS_ORIGIN=http://localhost:3000

# --- Report Schedule (kirim PDF via email) ---
# Isi SMTP sesuai penyedia email. Kosong = pengiriman gagal dengan pesan jelas di log.
SMTP_HOST=
SMTP_PORT=587
# true untuk port 465 (SSL), false untuk 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Pengirim yang tampil di email, contoh: FMS Report <noreply@rmko.co.id>
MAIL_FROM=
# Alamat frontend termasuk base path /fms, yang bisa diakses dari server backend (dibuka headless browser untuk render PDF)
FRONTEND_URL=http://localhost:8881/fms
# Opsional: path Chrome/Chromium sistem. Kosong = Chromium bawaan puppeteer.
PUPPETEER_EXECUTABLE_PATH=
